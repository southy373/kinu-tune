# Build directories
build/
build-*/
cmake-build-*/
dist/

# JUCE is now a git submodule in third_party/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.sdf
*.opensdf
*.vcxproj.user

# macOS
.DS_Store
*.xcodeproj/
*.xcworkspace/

# Compiled files
*.o
*.obj
*.exe
*.dll
*.dylib
*.so
*.a

# Temporary files
*.tmp
*.log

**/__pycache__/
Resources/models/*
# BigVGAN model is ~490 MB: generated by tools/convert_bigvgan.py in CI or
# placed by hand for local development, never committed.
Resources/models/bigvgan_v2_44khz_128band.onnx
# The ConvTranspose-free variant derived from it by the same script.
Resources/models/bigvgan_v2_44khz_128band_noct.onnx
# SiFi-GAN model and stats sidecar (batch 6): the project's own training
# output, committed like the FCPE model so the release packaging can
# ship them from the repository.
!Resources/models/sifigan_115k_gather.onnx
!Resources/models/sifigan_kokoro_stats.json

tempcalude-*
.claude
.cache

third_party/ASIOSDK/
/build-xcode
# Everything under third_party/ is ignored (the JUCE / ARA / r8brain
# submodules are tracked as gitlinks, which ignore rules do not affect),
# except the two vendored source drops committed in batch 4.
/third_party/*
!/third_party/rubberband
!/third_party/signalsmith-stretch
!/third_party/world
sign.sh
